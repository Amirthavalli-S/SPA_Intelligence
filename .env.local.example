# LOCAL RUN. Copy to .env (gitignored) and fill the blanks. Never commit real values, never paste them in chat.
# Mode 1 (simplest): no sign-in, no database, files on your disk. Only the Azure keys are needed.
AUTH_MODE=off
LLM_PROVIDER=azure_openai
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
LLM_MAX_CALLS=40
CORS_ORIGINS=http://localhost:5173
SERVE_FRONTEND=0

# Mode 2 (optional): same sign-in and database as Render. Uncomment all of these, set SERVE_FRONTEND=1
# and run `npm run build && npm run serve` (one server on http://localhost:8000).
# AUTH_MODE=supabase
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# DATABASE_URL=            # Supabase SESSION POOLER string; percent-encode special characters in the password (@ -> %40)
# SESSION_SECRET=          # any random string of 32+ characters (use a different one from Render)
# PUBLIC_BASE_URL=http://localhost:8000
# ADMIN_EMAILS=
# SERVE_FRONTEND=1

# Optional OCR for scanned PDFs (sends page images to the provider)
# QWEN_API_KEY=
# QWEN_MODEL=
# QWEN_BASE_URL=
